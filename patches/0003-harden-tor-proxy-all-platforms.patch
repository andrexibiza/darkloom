@@ -59,6 +59,15 @@ import crypto from "node:crypto";
 import { once } from "node:events";
 import { patchSpectrumTs } from "./patch-spectrum-mixed-attachments.mjs";

+// grpc-js, used by spectrum-ts, consumes the lower-case grpc_proxy variable.
+// Configure it before spectrum-ts is dynamically imported; merely copying the
+// parent environment into the sidecar does not configure the gRPC dialer.
+const photonProxy =
+  process.env.PHOTON_PROXY || process.env.ALL_PROXY || process.env.all_proxy;
+if (photonProxy && !process.env.grpc_proxy) {
+  process.env.grpc_proxy = photonProxy;
+}
+
 const projectId = process.env.PHOTON_PROJECT_ID;
