From: hermes-tor maintainers
Subject: [PATCH] security: enforce centralized Tor policy at network boundaries

This patch is applied to the Hermes integration repository after installing
hermes-tor.  Every check precedes client/socket/process construction.

diff --git a/gateway/platforms/base.py b/gateway/platforms/base.py
--- a/gateway/platforms/base.py
+++ b/gateway/platforms/base.py
@@
+from hermes_tor.policy import NetworkChannel, authorize
@@ def resolve_proxy_url(platform_env_var=None, target_hosts=None):
+    # The selected adapter must call this before constructing its client.
+    # In strict mode absence of a proxy is an error, never a direct fallback.
@@
-    return None
+    authorize(NetworkChannel.PLATFORM, proxy_url=None, proxy_aware=False)
+    return None

diff --git a/gateway/run.py b/gateway/run.py
--- a/gateway/run.py
+++ b/gateway/run.py
@@
+from hermes_tor.policy import NetworkChannel, authorize, configured_proxy
@@ def initialize_platforms(self):
+        authorize(NetworkChannel.GATEWAY, proxy_url=configured_proxy())

