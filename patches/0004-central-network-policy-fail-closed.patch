diff --git a/hermes_cli/_subprocess_compat.py b/hermes_cli/_subprocess_compat.py
--- a/hermes_cli/_subprocess_compat.py
+++ b/hermes_cli/_subprocess_compat.py
@@
+from hermes_tor.policy import authorize_subprocess, configured_proxy
+
+def authorize_network_child(*, proxy_aware: bool) -> None:
+    """Mandatory pre-launch guard for every network-capable child."""
+    authorize_subprocess(proxy_aware=proxy_aware, proxy_url=configured_proxy())

